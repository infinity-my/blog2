package com.example.bloghd.controller;

import com.example.bloghd.entity.AppUser;
import com.example.bloghd.entity.Message;
import com.example.bloghd.entity.MessageReply;
import com.example.bloghd.mapper.AppUserMapper;
import com.example.bloghd.mapper.MessageMapper;
import com.example.bloghd.mapper.MessageReplyMapper;
import jakarta.servlet.Filter;
import jakarta.servlet.http.Cookie;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.boot.test.context.SpringBootTest;
import org.springframework.http.MediaType;
import org.springframework.mock.web.MockHttpSession;
import org.springframework.test.context.ActiveProfiles;
import org.springframework.test.web.servlet.MockMvc;
import org.springframework.test.web.servlet.MvcResult;
import org.springframework.test.web.servlet.request.MockHttpServletRequestBuilder;
import org.springframework.test.web.servlet.setup.MockMvcBuilders;
import org.springframework.web.context.WebApplicationContext;

import java.time.LocalDateTime;

import static org.assertj.core.api.Assertions.assertThat;
import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get;
import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post;
import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath;
import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;

@SpringBootTest
@ActiveProfiles("test")
class AuthControllerTest {

    private static final String EMAIL = "probe@example.com";
    private static final String NAME = "探测用户";
    private static final String PASSWORD = "secret123";

    @Autowired
    private WebApplicationContext context;

    @Autowired
    private AppUserMapper appUserMapper;

    @Autowired
    private MessageMapper messageMapper;

    @Autowired
    private MessageReplyMapper messageReplyMapper;

    private MockMvc mockMvc;
    private Cookie csrfCookie;

    @BeforeEach
    void setUp() throws Exception {
        // 手工构建的 MockMvc 不会挂载安全过滤链，必须显式加上，否则鉴权被整体绕过
        mockMvc = MockMvcBuilders.webAppContextSetup(context)
                .addFilters(context.getBean("springSecurityFilterChain", Filter.class))
                .build();
        messageReplyMapper.delete(null);
        messageMapper.delete(null);
        appUserMapper.delete(null);
        // 账号接口挂了 CSRF，POST 必须回传 token；先 GET 一次拿 cookie
        csrfCookie = mockMvc.perform(get("/api/posts"))
                .andReturn().getResponse().getCookie("XSRF-TOKEN");
    }

    private MockHttpServletRequestBuilder authPost(String path, String body) {
        return post(path)
                .contentType(MediaType.APPLICATION_JSON)
                .content(body)
                .cookie(csrfCookie)
                .header("X-XSRF-TOKEN", csrfCookie.getValue());
    }

    private static String registerBody(String email, String name, String password) {
        return "{\"email\":\"%s\",\"name\":\"%s\",\"password\":\"%s\"}".formatted(email, name, password);
    }

    private static String loginBody(String email, String password) {
        return "{\"email\":\"%s\",\"password\":\"%s\"}".formatted(email, password);
    }

    private MockHttpSession registerAndGetSession(String email, String name, String password) throws Exception {
        MvcResult result = mockMvc.perform(authPost("/api/auth/register", registerBody(email, name, password)))
                .andExpect(status().isCreated())
                .andReturn();
        return (MockHttpSession) result.getRequest().getSession(false);
    }

    @Test
    void registerCreatesAccountHashesPasswordAndLogsIn() throws Exception {
        MockHttpSession session = registerAndGetSession(EMAIL, NAME, PASSWORD);
        assertThat(session).isNotNull();

        AppUser stored = appUserMapper.selectList(null).getFirst();
        assertThat(stored.getEmail()).isEqualTo(EMAIL);
        assertThat(stored.getName()).isEqualTo(NAME);
        // 明文不落库，且确实是 BCrypt 串
        assertThat(stored.getPasswordHash()).isNotEqualTo(PASSWORD);
        assertThat(stored.getPasswordHash()).startsWith("$2");
        assertThat(stored.getCreatedAt()).isNotNull();

        // 注册即登录，同一会话可直接读身份
        mockMvc.perform(get("/api/auth/me").session(session))
                .andExpect(status().isOk())
                .andExpect(jsonPath("$.email").value(EMAIL))
                .andExpect(jsonPath("$.name").value(NAME))
                .andExpect(jsonPath("$.id").value(stored.getId()))
                // 响应体不含任何密码字段
                .andExpect(jsonPath("$.password").doesNotExist())
                .andExpect(jsonPath("$.passwordHash").doesNotExist());
    }

    @Test
    void registerNormalizesEmailCaseAndSpacing() throws Exception {
        registerAndGetSession("  Probe@Example.COM  ", NAME, PASSWORD);

        assertThat(appUserMapper.selectList(null).getFirst().getEmail()).isEqualTo(EMAIL);

        // 大小写不同也能登录
        mockMvc.perform(authPost("/api/auth/login", loginBody("PROBE@example.com", PASSWORD)))
                .andExpect(status().isOk())
                .andExpect(jsonPath("$.email").value(EMAIL));
    }

    @Test
    void registerRejectsDuplicateEmail() throws Exception {
        registerAndGetSession(EMAIL, NAME, PASSWORD);

        mockMvc.perform(authPost("/api/auth/register", registerBody(EMAIL, "另一个人", PASSWORD)))
                .andExpect(status().isConflict())
                .andExpect(jsonPath("$.code").value("EMAIL_TAKEN"));

        assertThat(appUserMapper.selectList(null)).hasSize(1);
    }

    @Test
    void registerValidatesEachField() throws Exception {
        mockMvc.perform(authPost("/api/auth/register", registerBody("not-an-email", NAME, PASSWORD)))
                .andExpect(status().isBadRequest())
                .andExpect(jsonPath("$.code").value("INVALID_EMAIL"));

        mockMvc.perform(authPost("/api/auth/register", registerBody(EMAIL, "   ", PASSWORD)))
                .andExpect(status().isBadRequest())
                .andExpect(jsonPath("$.code").value("INVALID_NAME"));

        // 21 个字符，刚好越过 20 的上限
        mockMvc.perform(authPost("/api/auth/register", registerBody(EMAIL, "超".repeat(21), PASSWORD)))
                .andExpect(status().isBadRequest())
                .andExpect(jsonPath("$.code").value("INVALID_NAME"));

        mockMvc.perform(authPost("/api/auth/register", registerBody(EMAIL, NAME, "12345")))
                .andExpect(status().isBadRequest())
                .andExpect(jsonPath("$.code").value("INVALID_PASSWORD"));

        mockMvc.perform(authPost("/api/auth/register", registerBody(EMAIL, NAME, "x".repeat(73))))
                .andExpect(status().isBadRequest())
                .andExpect(jsonPath("$.code").value("INVALID_PASSWORD"));

        assertThat(appUserMapper.selectList(null)).isEmpty();
    }

    @Test
    void loginDistinguishesUnknownEmailFromWrongPassword() throws Exception {
        mockMvc.perform(authPost("/api/auth/login", loginBody(EMAIL, PASSWORD)))
                .andExpect(status().isUnauthorized())
                .andExpect(jsonPath("$.code").value("UNKNOWN_EMAIL"));

        registerAndGetSession(EMAIL, NAME, PASSWORD);

        mockMvc.perform(authPost("/api/auth/login", loginBody(EMAIL, "wrong-password")))
                .andExpect(status().isUnauthorized())
                .andExpect(jsonPath("$.code").value("WRONG_PASSWORD"));
    }

    @Test
    void loginRotatesSessionIdToPreventFixation() throws Exception {
        registerAndGetSession(EMAIL, NAME, PASSWORD);

        // 攻击者预先固定一个 session id，受害者登录后该 id 若不变则可被劫持
        MockHttpSession attackerFixed = new MockHttpSession();
        String before = attackerFixed.getId();

        mockMvc.perform(authPost("/api/auth/login", loginBody(EMAIL, PASSWORD)).session(attackerFixed))
                .andExpect(status().isOk());

        assertThat(attackerFixed.getId()).isNotEqualTo(before);
    }

    @Test
    void meRequiresAuthentication() throws Exception {
        mockMvc.perform(get("/api/auth/me")).andExpect(status().isUnauthorized());

        MockHttpSession session = registerAndGetSession(EMAIL, NAME, PASSWORD);
        mockMvc.perform(get("/api/auth/me").session(session))
                .andExpect(status().isOk())
                .andExpect(jsonPath("$.email").value(EMAIL));
    }

    @Test
    void logoutEndsSession() throws Exception {
        MockHttpSession session = registerAndGetSession(EMAIL, NAME, PASSWORD);

        mockMvc.perform(authPost("/api/auth/logout", "").session(session))
                .andExpect(status().isNoContent());

        // 会话已失效，再访问受保护接口回到未登录状态
        mockMvc.perform(get("/api/auth/me")).andExpect(status().isUnauthorized());
    }

    @Test
    void deleteRequiresCorrectPassword() throws Exception {
        MockHttpSession session = registerAndGetSession(EMAIL, NAME, PASSWORD);

        mockMvc.perform(authPost("/api/auth/delete", "{\"password\":\"wrong-password\"}").session(session))
                .andExpect(status().isForbidden())
                .andExpect(jsonPath("$.code").value("WRONG_PASSWORD"));

        // 失败后账号仍在
        assertThat(appUserMapper.selectList(null)).hasSize(1);
    }

    @Test
    void deleteAnonymizesMessagesAndRemovesAccount() throws Exception {
        MockHttpSession session = registerAndGetSession(EMAIL, NAME, PASSWORD);
        Long userId = appUserMapper.selectList(null).getFirst().getId();

        Message mine = new Message();
        mine.setName(NAME);
        mine.setContent("我发的留言");
        mine.setLikes(0);
        mine.setCreatedAt(LocalDateTime.of(2026, 9, 24, 10, 0));
        mine.setUserId(userId);
        messageMapper.insert(mine);

        Message guest = new Message();
        guest.setName("访客");
        guest.setContent("别人的留言");
        guest.setLikes(0);
        guest.setCreatedAt(LocalDateTime.of(2026, 9, 24, 10, 1));
        guest.setUserId(null);
        messageMapper.insert(guest);

        MessageReply reply = new MessageReply();
        reply.setMessageId(mine.getId());
        reply.setName(NAME);
        reply.setContent("我的回复");
        reply.setLikes(0);
        reply.setCreatedAt(LocalDateTime.of(2026, 9, 24, 10, 2));
        reply.setIsAuthor(false);
        reply.setUserId(userId);
        messageReplyMapper.insert(reply);

        mockMvc.perform(authPost("/api/auth/delete", "{\"password\":\"" + PASSWORD + "\"}").session(session))
                .andExpect(status().isNoContent());

        // 账号没了
        assertThat(appUserMapper.selectById(userId)).isNull();

        // 留言与回复保留，只断开与账号的关联
        Message mineAfter = messageMapper.selectById(mine.getId());
        assertThat(mineAfter).isNotNull();
        assertThat(mineAfter.getUserId()).isNull();
        assertThat(mineAfter.getName()).isEqualTo(NAME);
        assertThat(mineAfter.getContent()).isEqualTo("我发的留言");

        assertThat(messageReplyMapper.selectById(reply.getId()).getUserId()).isNull();

        // 别人的留言不受影响
        assertThat(messageMapper.selectById(guest.getId()).getContent()).isEqualTo("别人的留言");
    }

    @Test
    void accountEndpointsRejectRequestsWithoutCsrfToken() throws Exception {
        mockMvc.perform(post("/api/auth/login")
                        .contentType(MediaType.APPLICATION_JSON)
                        .content(loginBody(EMAIL, PASSWORD)))
                .andExpect(status().isForbidden());
    }

    @Test
    void publicWriteEndpointsRemainOpenWithoutCsrfToken() throws Exception {
        // 公开写接口不在 CSRF 保护范围内，未登录也能发留言
        mockMvc.perform(post("/api/messages")
                        .contentType(MediaType.APPLICATION_JSON)
                        .content("{\"name\":\"访客\",\"content\":\"公开留言\"}"))
                .andExpect(status().isOk());
    }
}
