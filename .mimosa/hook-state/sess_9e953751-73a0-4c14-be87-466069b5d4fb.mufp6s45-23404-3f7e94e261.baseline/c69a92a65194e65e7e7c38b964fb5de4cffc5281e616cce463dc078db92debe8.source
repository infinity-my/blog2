package com.example.bloghd.security;

import org.springframework.http.HttpStatus;
import org.springframework.stereotype.Component;

import java.util.ArrayDeque;
import java.util.Deque;
import java.util.HashMap;
import java.util.Locale;
import java.util.Map;

/**
 * 登录类接口的内存限流，挡暴力试密码与邮箱探测。
 * 滑动窗口 15 分钟：同一「邮箱+IP」失败 5 次、或同一 IP 失败 30 次即拒绝，
 * 成功后清空该身份的计数。单实例博客够用；进程重启计数清零，攻击窗口随之重来。
 */
@Component
public class LoginRateLimiter {

    static final int MAX_FAILURES_PER_IDENTITY = 5;
    static final int MAX_FAILURES_PER_IP = 30;
    private static final long WINDOW_MILLIS = 15 * 60 * 1000L;

    /**
     * 身份锁的 key 是「邮箱|出口 IP」：攻击者只能锁死自己 IP 上的组合，
     * 无法借此把别人的邮箱整体锁到登录不了。
     */
    private final Map<String, Deque<Long>> failuresByIdentity = new HashMap<>();
    private final Map<String, Deque<Long>> failuresByIp = new HashMap<>();

    /** 超限抛 429 TOO_MANY_ATTEMPTS，文案带剩余等待分钟数 */
    public synchronized void checkOrThrow(String email, String ip) {
        long now = System.currentTimeMillis();
        int identityWait = blockedMinutes(failuresByIdentity, identityKey(email, ip), MAX_FAILURES_PER_IDENTITY, now);
        int ipWait = blockedMinutes(failuresByIp, ip, MAX_FAILURES_PER_IP, now);
        int waitMinutes = Math.max(identityWait, ipWait);
        if (waitMinutes > 0) {
            throw new AuthException(HttpStatus.TOO_MANY_REQUESTS, "TOO_MANY_ATTEMPTS",
                    "尝试太频繁了，请 " + waitMinutes + " 分钟后再试");
        }
    }

    public synchronized void recordFailure(String email, String ip) {
        long now = System.currentTimeMillis();
        failuresByIdentity.computeIfAbsent(identityKey(email, ip), k -> new ArrayDeque<>()).addLast(now);
        failuresByIp.computeIfAbsent(ip, k -> new ArrayDeque<>()).addLast(now);
    }

    /**
     * 成功后清空该身份与该 IP 的失败记录。
     * IP 的失败队列是同出口 IP 下所有邮箱共用的，一并清掉即视为「这个出口不像在攻击」。
     */
    public synchronized void reset(String email, String ip) {
        failuresByIdentity.remove(identityKey(email, ip));
        failuresByIp.remove(ip);
    }

    private static String identityKey(String email, String ip) {
        return email.toLowerCase(Locale.ROOT) + "|" + ip;
    }

    /** 未超限返回 -1；超限返回按窗口内最早一次失败算出的剩余等待分钟数（至少 1） */
    private static int blockedMinutes(Map<String, Deque<Long>> failures, String key, int maxFailures, long now) {
        Deque<Long> window = failures.get(key);
        if (window == null) {
            return -1;
        }
        prune(window, now);
        if (window.isEmpty()) {
            failures.remove(key);
            return -1;
        }
        if (window.size() < maxFailures) {
            return -1;
        }
        long remainMillis = window.peekFirst() + WINDOW_MILLIS - now;
        return Math.max(1, (int) Math.ceil(remainMillis / 60000.0));
    }

    private static void prune(Deque<Long> window, long now) {
        while (!window.isEmpty() && window.peekFirst() + WINDOW_MILLIS <= now) {
            window.pollFirst();
        }
    }
}
