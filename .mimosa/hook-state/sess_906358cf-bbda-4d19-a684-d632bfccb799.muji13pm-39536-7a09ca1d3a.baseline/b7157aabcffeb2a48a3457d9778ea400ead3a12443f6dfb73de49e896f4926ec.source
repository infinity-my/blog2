package com.example.bloghd.controller;

import com.example.bloghd.support.AssetStorage;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RequestParam;
import org.springframework.web.bind.annotation.RestController;
import org.springframework.web.multipart.MultipartFile;

import java.util.Map;

/** 上传接口：图片落盘到 data/assets，返回 /api/assets URL 供相册/随笔等引用 */
@RestController
@RequestMapping("/api/admin")
public class AdminUploadController {

    private final AssetStorage assetStorage;

    public AdminUploadController(AssetStorage assetStorage) {
        this.assetStorage = assetStorage;
    }

    @PostMapping("/upload")
    public Map<String, String> upload(@RequestParam("file") MultipartFile file,
                                      @RequestParam(defaultValue = "misc") String folder) {
        return Map.of("url", assetStorage.store(file, folder));
    }
}
