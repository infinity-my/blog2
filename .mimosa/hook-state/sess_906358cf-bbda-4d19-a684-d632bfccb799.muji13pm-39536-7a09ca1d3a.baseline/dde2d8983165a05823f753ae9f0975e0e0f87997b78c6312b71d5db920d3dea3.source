package com.example.bloghd.controller;

import com.example.bloghd.entity.ResumeContent;
import com.example.bloghd.mapper.ResumeContentMapper;
import jakarta.servlet.Filter;
import jakarta.servlet.http.Cookie;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.boot.test.context.SpringBootTest;
import org.springframework.http.MediaType;
import org.springframework.mock.web.MockHttpSession;
import org.springframework.test.context.ActiveProfiles;
import org.springframework.test.web.servlet.MockMvc;
import org.springframework.test.web.servlet.ResultActions;
import org.springframework.test.web.servlet.request.MockHttpServletRequestBuilder;
import org.springframework.test.web.servlet.setup.MockMvcBuilders;
import org.springframework.web.context.WebApplicationContext;

import java.time.LocalDateTime;

import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get;
import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post;
import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath;
import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;

@SpringBootTest(properties = "blog.resume.password=secret-pass")
@ActiveProfiles("test")
class ResumeControllerTest {

    @Autowired
    private WebApplicationContext context;

    @Autowired
    private ResumeContentMapper resumeContentMapper;

    private MockMvc mockMvc;
    private Cookie csrfCookie;

    @BeforeEach
    void setUp() throws Exception {
        // 手工构建的 MockMvc 不会挂载安全过滤链，必须显式加上，否则鉴权被整体绕过
        mockMvc = MockMvcBuilders.webAppContextSetup(context)
                .addFilters(context.getBean("springSecurityFilterChain", Filter.class))
                .build();
        resumeContentMapper.delete(null);
        csrfCookie = mockMvc.perform(get("/api/posts")).andReturn().getResponse().getCookie("XSRF-TOKEN");
    }

    /** 简历解锁也挂了 CSRF，POST 统一带 token */
    private ResultActions unlock(MockHttpServletRequestBuilder builder) throws Exception {
        return mockMvc.perform(builder
                .contentType(MediaType.APPLICATION_JSON)
                .cookie(csrfCookie)
                .header("X-XSRF-TOKEN", csrfCookie.getValue()));
    }

    private MockHttpServletRequestBuilder unlockPost(String body) {
        return post("/api/resume/unlock").content(body);
    }

    /** 库里没有内容时接口无从返回，先种一行 */
    private void seedResumeContent() {
        ResumeContent row = new ResumeContent();
        row.setPayload("{\"updatedAt\":\"2026-09-24\",\"profile\":{\"name\":\"陈屿\"},\"metrics\":[]}");
        row.setUpdatedAt(LocalDateTime.of(2026, 9, 24, 0, 0));
        resumeContentMapper.insert(row);
    }

    @Test
    void unlockAcceptsCorrectPassword() throws Exception {
        unlock(unlockPost("{\"password\":\"secret-pass\"}"))
                .andExpect(status().isOk())
                .andExpect(jsonPath("$.unlocked").value(true));
    }

    @Test
    void unlockTrimsWhitespaceBeforeComparing() throws Exception {
        unlock(unlockPost("{\"password\":\"  secret-pass  \"}"))
                .andExpect(status().isOk());
    }

    @Test
    void unlockRejectsWrongPassword() throws Exception {
        unlock(unlockPost("{\"password\":\"secret\"}"))
                .andExpect(status().isUnauthorized());
        unlock(unlockPost("{\"password\":\"Secret-Pass\"}"))
                .andExpect(status().isUnauthorized());
    }

    @Test
    void unlockRejectsBlankPassword() throws Exception {
        unlock(unlockPost("{\"password\":\"   \"}"))
                .andExpect(status().isBadRequest());
        unlock(unlockPost("{}"))
                .andExpect(status().isBadRequest());
    }

    @Test
    void contentRequiresUnlockFirst() throws Exception {
        seedResumeContent();

        // 从没解锁过：直接取内容按未授权处理
        mockMvc.perform(get("/api/resume/content"))
                .andExpect(status().isUnauthorized());

        // 口令错了也不留下解锁标记
        MockHttpSession failed = new MockHttpSession();
        unlock(unlockPost("{\"password\":\"wrong\"}").session(failed))
                .andExpect(status().isUnauthorized());
        mockMvc.perform(get("/api/resume/content").session(failed))
                .andExpect(status().isUnauthorized());
    }

    @Test
    void contentReturnsFullPayloadAfterUnlock() throws Exception {
        seedResumeContent();

        MockHttpSession session = new MockHttpSession();
        unlock(unlockPost("{\"password\":\"secret-pass\"}").session(session))
                .andExpect(status().isOk());

        // 同一会话内取到整包内容；新会话（服务重启/过期）则仍被拦下
        mockMvc.perform(get("/api/resume/content").session(session))
                .andExpect(status().isOk())
                .andExpect(jsonPath("$.updatedAt").value("2026-09-24"))
                .andExpect(jsonPath("$.profile.name").value("陈屿"));

        mockMvc.perform(get("/api/resume/content").session(new MockHttpSession()))
                .andExpect(status().isUnauthorized());
    }

    @Test
    void contentIsNotFoundWhenNothingConfigured() throws Exception {
        MockHttpSession session = new MockHttpSession();
        unlock(unlockPost("{\"password\":\"secret-pass\"}").session(session))
                .andExpect(status().isOk());

        mockMvc.perform(get("/api/resume/content").session(session))
                .andExpect(status().isNotFound());
    }
}
