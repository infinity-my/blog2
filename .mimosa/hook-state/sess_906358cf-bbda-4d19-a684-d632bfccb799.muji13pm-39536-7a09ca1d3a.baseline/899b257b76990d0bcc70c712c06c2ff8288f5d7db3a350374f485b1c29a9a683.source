package com.example.bloghd.controller;

import com.baomidou.mybatisplus.core.conditions.query.LambdaQueryWrapper;
import com.example.bloghd.dto.CommentView;
import com.example.bloghd.entity.Article;
import com.example.bloghd.entity.Comment;
import com.example.bloghd.mapper.ArticleMapper;
import com.example.bloghd.mapper.CommentMapper;
import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.DeleteMapping;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PathVariable;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;
import org.springframework.web.server.ResponseStatusException;

import java.util.List;
import java.util.Map;
import java.util.function.Function;
import java.util.stream.Collectors;

/**
 * 后台的评论维护接口：全量列表（最新在前，带文章标题便于定位）与单条删除。
 * 删文章时评论随文章级联删除（见 AdminPostController），这里只管单条清理。
 */
@RestController
@RequestMapping("/api/admin/comments")
public class AdminCommentController {

    private final CommentMapper commentMapper;
    private final ArticleMapper articleMapper;

    public AdminCommentController(CommentMapper commentMapper, ArticleMapper articleMapper) {
        this.commentMapper = commentMapper;
        this.articleMapper = articleMapper;
    }

    @GetMapping
    public List<AdminCommentView> list() {
        Map<Long, Article> articles = articleMapper.selectList(null).stream()
                .collect(Collectors.toMap(Article::getId, Function.identity()));
        return commentMapper.selectList(new LambdaQueryWrapper<Comment>()
                        .orderByDesc(Comment::getCreatedAt, Comment::getId))
                .stream()
                .map(c -> AdminCommentView.from(c, articles.get(c.getArticleId())))
                .toList();
    }

    @DeleteMapping("/{id}")
    public ResponseEntity<Void> delete(@PathVariable Long id) {
        if (commentMapper.deleteById(id) == 0) {
            throw new ResponseStatusException(HttpStatus.NOT_FOUND, "评论不存在");
        }
        return ResponseEntity.noContent().build();
    }

    /** 文章被直接删库等极端情况下标题可能缺，兜底显示占位而不是整页挂掉 */
    public record AdminCommentView(Long id,
                                   Long articleId,
                                   String articleTitle,
                                   Long userId,
                                   String name,
                                   String time,
                                   String content) {

        static AdminCommentView from(Comment c, Article article) {
            return new AdminCommentView(c.getId(), c.getArticleId(),
                    article != null ? article.getTitle() : "（文章已删除）",
                    c.getUserId(), c.getName(), CommentView.from(c).time(), c.getContent());
        }
    }
}
