package com.example.bloghd.controller;

import com.example.bloghd.entity.Article;
import com.example.bloghd.entity.Comment;
import com.example.bloghd.entity.Message;
import com.example.bloghd.entity.MessageReply;
import com.example.bloghd.entity.SiteVisit;
import com.example.bloghd.mapper.AppUserMapper;
import com.example.bloghd.mapper.ArticleMapper;
import com.example.bloghd.mapper.CommentMapper;
import com.example.bloghd.mapper.MessageMapper;
import com.example.bloghd.mapper.MessageReplyMapper;
import com.example.bloghd.mapper.SiteVisitMapper;
import com.example.bloghd.security.LoginRateLimiter;
import jakarta.servlet.Filter;
import jakarta.servlet.http.Cookie;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.boot.test.context.SpringBootTest;
import org.springframework.http.MediaType;
import org.springframework.mock.web.MockHttpSession;
import org.springframework.test.context.ActiveProfiles;
import org.springframework.test.context.DynamicPropertyRegistry;
import org.springframework.test.context.DynamicPropertySource;
import org.springframework.test.web.servlet.MockMvc;
import org.springframework.test.web.servlet.MvcResult;
import org.springframework.test.web.servlet.request.MockHttpServletRequestBuilder;
import org.springframework.test.web.servlet.setup.MockMvcBuilders;
import org.springframework.web.context.WebApplicationContext;

import java.time.LocalDate;
import java.time.LocalDateTime;
import java.util.UUID;

import static org.assertj.core.api.Assertions.assertThat;
import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.delete;
import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get;
import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post;
import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.put;
import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath;
import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;

@SpringBootTest
// 管理员口令运行期随机生成（见下方 DynamicPropertySource），源码不出现凭据字面量
@ActiveProfiles("test")
class AdminApiTest {

    private static final String ADMIN_USERNAME = "admin";
    private static final String ADMIN_PASSWORD = "pwd-" + UUID.randomUUID().toString().substring(0, 12);
    // 测试账号口令同样运行期随机生成：源码不出现凭据字面量，扫描器也不会误报
    private static final String VISITOR_EMAIL = "visitor@example.com";
    private static final String VISITOR_PASSWORD = "pwd-" + UUID.randomUUID().toString().substring(0, 12);

    @DynamicPropertySource
    static void adminProps(DynamicPropertyRegistry registry) {
        registry.add("blog.admin.username", () -> ADMIN_USERNAME);
        registry.add("blog.admin.password", () -> ADMIN_PASSWORD);
    }

    @Autowired
    private WebApplicationContext context;

    @Autowired
    private ArticleMapper articleMapper;

    @Autowired
    private MessageMapper messageMapper;

    @Autowired
    private MessageReplyMapper messageReplyMapper;

    @Autowired
    private AppUserMapper appUserMapper;

    @Autowired
    private CommentMapper commentMapper;

    @Autowired
    private SiteVisitMapper siteVisitMapper;

    @Autowired
    private LoginRateLimiter rateLimiter;

    private MockMvc mockMvc;
    private Cookie csrfCookie;

    @BeforeEach
    void setUp() throws Exception {
        // 手工构建的 MockMvc 不会挂载安全过滤链，必须显式加上，否则鉴权被整体绕过
        mockMvc = MockMvcBuilders.webAppContextSetup(context)
                .addFilters(context.getBean("springSecurityFilterChain", Filter.class))
                .build();
        commentMapper.delete(null);
        articleMapper.delete(null);
        messageReplyMapper.delete(null);
        messageMapper.delete(null);
        appUserMapper.delete(null);
        // 限流器是单例，失败记录会跨测试留存，先清干净保证确定性
        rateLimiter.reset("admin:" + ADMIN_USERNAME, "127.0.0.1");
        csrfCookie = mockMvc.perform(get("/api/posts"))
                .andReturn().getResponse().getCookie("XSRF-TOKEN");
    }

    private MockHttpServletRequestBuilder csrf(MockHttpServletRequestBuilder builder) {
        return builder.cookie(csrfCookie).header("X-XSRF-TOKEN", csrfCookie.getValue());
    }

    private MockHttpServletRequestBuilder jsonPost(String path, String body) {
        return csrf(post(path).contentType(MediaType.APPLICATION_JSON).content(body));
    }

    private MockHttpServletRequestBuilder jsonPut(String path, String body) {
        return csrf(put(path).contentType(MediaType.APPLICATION_JSON).content(body));
    }

    private MockHttpSession adminSession() throws Exception {
        MvcResult result = mockMvc.perform(jsonPost("/api/admin/login", loginBody(ADMIN_USERNAME, ADMIN_PASSWORD)))
                .andExpect(status().isOk())
                .andExpect(jsonPath("$.name").value("博主"))
                .andReturn();
        return (MockHttpSession) result.getRequest().getSession(false);
    }

    private MockHttpSession visitorSession() throws Exception {
        String body = "{\"email\":\"%s\",\"name\":\"访客\",\"password\":\"%s\"}"
                .formatted(VISITOR_EMAIL, VISITOR_PASSWORD);
        MvcResult result = mockMvc.perform(jsonPost("/api/auth/register", body))
                .andExpect(status().isCreated())
                .andReturn();
        return (MockHttpSession) result.getRequest().getSession(false);
    }

    private static String loginBody(String username, String password) {
        return "{\"username\":\"%s\",\"password\":\"%s\"}".formatted(username, password);
    }

    private static final String POST_BODY = """
            {
              "title": "后台新建的文章",
              "excerpt": "摘要",
              "publishDate": "2026-09-24",
              "category": "前端",
              "tags": ["Vue", "测试"],
              "content": [
                {"type": "p", "text": "第一段"},
                {"type": "h2", "text": "小标题"},
                {"type": "ul", "items": ["甲", "乙"]},
                {"type": "code", "lang": "js", "code": "const a = 1;"},
                {"type": "quote", "text": "引用"}
              ]
            }
            """;

    @Test
    void adminWriteEndpointsRejectAnonymousAndVisitors() throws Exception {
        // 匿名：入口点回 401
        mockMvc.perform(get("/api/admin/me"))
                .andExpect(status().isUnauthorized());
        mockMvc.perform(get("/api/admin/posts"))
                .andExpect(status().isUnauthorized());

        // 已登录访客：角色不对，回 403
        MockHttpSession visitor = visitorSession();
        mockMvc.perform(get("/api/admin/me").session(visitor))
                .andExpect(status().isForbidden());
        mockMvc.perform(csrf(delete("/api/admin/messages/1")).session(visitor))
                .andExpect(status().isForbidden());
    }

    @Test
    void adminLoginLogoutRoundtrip() throws Exception {
        mockMvc.perform(jsonPost("/api/admin/login", loginBody(ADMIN_USERNAME, "wrong-password")))
                .andExpect(status().isUnauthorized())
                .andExpect(jsonPath("$.code").value("BAD_CREDENTIALS"));

        mockMvc.perform(jsonPost("/api/admin/login", loginBody("not-admin", ADMIN_PASSWORD)))
                .andExpect(status().isUnauthorized());

        MockHttpSession session = adminSession();
        mockMvc.perform(get("/api/admin/me").session(session))
                .andExpect(status().isOk())
                .andExpect(jsonPath("$.name").value("博主"));

        mockMvc.perform(jsonPost("/api/admin/logout", "{}").session(session))
                .andExpect(status().isNoContent());
        mockMvc.perform(get("/api/admin/me").session(session))
                .andExpect(status().isUnauthorized());
    }

    @Test
    void postCrudRoundtripThroughPublicEndpoints() throws Exception {
        MockHttpSession session = adminSession();

        MvcResult created = mockMvc.perform(jsonPost("/api/admin/posts", POST_BODY).session(session))
                .andExpect(status().isCreated())
                .andExpect(jsonPath("$.id").isNumber())
                .andExpect(jsonPath("$.title").value("后台新建的文章"))
                .andReturn();
        long id = Long.parseLong(created.getResponse().getContentAsString()
                .replaceAll(".*\"id\":(\\d+).*", "$1"));

        // 列表与详情走公开接口，后台不改读路径
        mockMvc.perform(get("/api/posts/" + id))
                .andExpect(status().isOk())
                .andExpect(jsonPath("$.category").value("前端"))
                .andExpect(jsonPath("$.content.length()").value(5));

        String updated = POST_BODY.replace("后台新建的文章", "改过的标题");
        mockMvc.perform(jsonPut("/api/admin/posts/" + id, updated).session(session))
                .andExpect(status().isOk())
                .andExpect(jsonPath("$.title").value("改过的标题"));

        mockMvc.perform(csrf(delete("/api/admin/posts/" + id)).session(session))
                .andExpect(status().isNoContent());
        mockMvc.perform(get("/api/posts/" + id))
                .andExpect(status().isNotFound());
    }

    @Test
    void postCreateValidatesFieldsAndBlockTypes() throws Exception {
        MockHttpSession session = adminSession();

        mockMvc.perform(jsonPost("/api/admin/posts", POST_BODY.replace("后台新建的文章", " ")).session(session))
                .andExpect(status().isBadRequest());

        mockMvc.perform(jsonPost("/api/admin/posts", POST_BODY.replace("\"type\": \"p\"", "\"type\": \"h3\"")).session(session))
                .andExpect(status().isBadRequest());

        mockMvc.perform(jsonPost("/api/admin/posts", POST_BODY.replace("\"publishDate\": \"2026-09-24\"", "\"publishDate\": null")).session(session))
                .andExpect(status().isBadRequest());

        assertThat(articleMapper.selectList(null)).isEmpty();
    }

    @Test
    void adminListsAndDeletesCommentsAndArticleDeleteCascades() throws Exception {
        Article article = new Article();
        article.setTitle("被评论的文章");
        article.setCategory("前端");
        article.setPublishDate(java.time.LocalDate.of(2026, 9, 1));
        article.setViews(0);
        articleMapper.insert(article);

        Comment first = new Comment();
        first.setArticleId(article.getId());
        first.setName("访客甲");
        first.setContent("第一条评论");
        first.setCreatedAt(LocalDateTime.of(2026, 9, 1, 10, 0));
        commentMapper.insert(first);

        Comment second = new Comment();
        second.setArticleId(article.getId());
        second.setName("访客乙");
        second.setContent("第二条评论");
        second.setCreatedAt(LocalDateTime.of(2026, 9, 1, 11, 0));
        commentMapper.insert(second);

        // 访客进不了后台评论接口
        mockMvc.perform(get("/api/admin/comments").session(visitorSession()))
                .andExpect(status().isForbidden());

        MockHttpSession session = adminSession();

        // 列表最新在前，带文章标题便于定位
        mockMvc.perform(get("/api/admin/comments").session(session))
                .andExpect(status().isOk())
                .andExpect(jsonPath("$.length()").value(2))
                .andExpect(jsonPath("$[0].name").value("访客乙"))
                .andExpect(jsonPath("$[0].articleTitle").value("被评论的文章"));

        // 单条删除：只动自己
        mockMvc.perform(csrf(delete("/api/admin/comments/" + first.getId())).session(session))
                .andExpect(status().isNoContent());
        mockMvc.perform(csrf(delete("/api/admin/comments/" + first.getId())).session(session))
                .andExpect(status().isNotFound());
        assertThat(commentMapper.selectList(null)).hasSize(1);

        // 删文章，剩余评论级联消失
        mockMvc.perform(csrf(delete("/api/admin/posts/" + article.getId())).session(session))
                .andExpect(status().isNoContent());
        assertThat(commentMapper.selectList(null)).isEmpty();
    }

    @Test
    void adminReplyLandsAsAuthorOnPublicBoard() throws Exception {
        Message message = new Message();
        message.setName("路人");
        message.setContent("主楼");
        message.setLikes(0);
        message.setCreatedAt(LocalDateTime.of(2026, 9, 24, 10, 0));
        messageMapper.insert(message);

        MockHttpSession session = adminSession();

        mockMvc.perform(jsonPost("/api/admin/messages/" + message.getId() + "/replies",
                        "{\"content\":\"收到，下期就聊这个\",\"replyTo\":\"路人\"}").session(session))
                .andExpect(status().isOk())
                .andExpect(jsonPath("$.name").value("博主"))
                .andExpect(jsonPath("$.author").value(true))
                .andExpect(jsonPath("$.replyTo").value("路人"));

        // 公开留言板上能看到这条带博主徽标的回复（列表是翻页封装）
        mockMvc.perform(get("/api/messages"))
                .andExpect(status().isOk())
                .andExpect(jsonPath("$.items[0].replies[0].author").value(true))
                .andExpect(jsonPath("$.items[0].replies[0].name").value("博主"));

        // 校验：空内容 400，主楼不存在 404
        mockMvc.perform(jsonPost("/api/admin/messages/" + message.getId() + "/replies",
                        "{\"content\":\"   \"}").session(session))
                .andExpect(status().isBadRequest());
        mockMvc.perform(jsonPost("/api/admin/messages/9999/replies",
                        "{\"content\":\"hi\"}").session(session))
                .andExpect(status().isNotFound());

        // 访客会话进不来
        mockMvc.perform(jsonPost("/api/admin/messages/" + message.getId() + "/replies",
                        "{\"content\":\"hi\"}").session(visitorSession()))
                .andExpect(status().isForbidden());
    }

    @Test
    void dailyVisitsWindowIsZeroFilledAndAdminOnly() throws Exception {
        // 访客与匿名都进不来
        mockMvc.perform(get("/api/admin/stats/daily"))
                .andExpect(status().isUnauthorized());
        mockMvc.perform(get("/api/admin/stats/daily").session(visitorSession()))
                .andExpect(status().isForbidden());

        LocalDate today = LocalDate.now();
        // 先清干净再种，保证断言确定性（H2 上下文在测试类间共享）
        siteVisitMapper.delete(null);
        visit(today, 5);
        visit(today.minusDays(2), 3);

        MockHttpSession session = adminSession();
        String json = mockMvc.perform(get("/api/admin/stats/daily").param("days", "3").session(session))
                .andExpect(status().isOk())
                .andReturn().getResponse().getContentAsString();

        // 窗口含今天共 3 天，缺失日零填充；total 为全站累计（此处即 8）
        assertThat(json).contains("\"total\":8");
        assertThat(json).contains("\"" + today.minusDays(2) + "\":3");
        assertThat(json).contains("\"" + today.minusDays(1) + "\":0");
        assertThat(json).contains("\"" + today + "\":5");
        int commas = json.split("\"days\":\\{")[1].split(",").length;
        assertThat(commas).isEqualTo(3);
    }

    private void visit(LocalDate date, int count) {
        SiteVisit v = new SiteVisit();
        v.setStatDate(date);
        v.setVisits(count);
        siteVisitMapper.insert(v);
    }

    @Test
    void deleteMessageCascadesRepliesAndReplyDeleteKeepsMessage() throws Exception {
        Message message = new Message();
        message.setName("路人");
        message.setContent("主楼");
        message.setLikes(0);
        message.setCreatedAt(LocalDateTime.now().withNano(0));
        messageMapper.insert(message);

        MessageReply reply = new MessageReply();
        reply.setMessageId(message.getId());
        reply.setName("博主");
        reply.setContent("回复");
        reply.setLikes(0);
        reply.setCreatedAt(LocalDateTime.now().withNano(0));
        reply.setIsAuthor(true);
        messageReplyMapper.insert(reply);

        MockHttpSession session = adminSession();

        // 删回复：只动回复自己
        mockMvc.perform(csrf(delete("/api/admin/messages/replies/" + reply.getId())).session(session))
                .andExpect(status().isNoContent());
        assertThat(messageReplyMapper.selectList(null)).isEmpty();
        assertThat(messageMapper.selectList(null)).hasSize(1);

        // 删主楼：回复一起消失
        mockMvc.perform(csrf(delete("/api/admin/messages/" + message.getId())).session(session))
                .andExpect(status().isNoContent());
        assertThat(messageMapper.selectList(null)).isEmpty();
        assertThat(messageReplyMapper.selectList(null)).isEmpty();

        mockMvc.perform(csrf(delete("/api/admin/messages/" + message.getId())).session(session))
                .andExpect(status().isNotFound());
    }
}
