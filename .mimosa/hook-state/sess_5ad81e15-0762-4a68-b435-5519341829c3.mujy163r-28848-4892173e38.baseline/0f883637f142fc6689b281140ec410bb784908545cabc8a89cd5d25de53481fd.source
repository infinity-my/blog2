import { fileURLToPath, URL } from 'node:url'

import { defineConfig } from 'vite'
import vue from '@vitejs/plugin-vue'
import vueDevTools from 'vite-plugin-vue-devtools'

// https://vite.dev/config/
export default defineConfig({
  // 生产挂在域名 /admin/ 子路径下（Caddy/nginx 按此前缀提供静态文件）；
  // 路由 history base 用 import.meta.env.BASE_URL 自动跟随，本地 dev 也从 /admin/ 访问
  base: '/admin/',
  plugins: [vue(), vueDevTools()],
  resolve: {
    alias: {
      '@': fileURLToPath(new URL('./src', import.meta.url)),
    },
  },
  server: {
    proxy: {
      // 开发代理：/api 转发到 blog-hd 后端（Spring Boot，默认 8080）；
      // 需要临时指向别的实例时用 BACKEND 环境变量覆盖（如 npm run dev 前设 BACKEND=http://localhost:8081）
      '/api': {
        target: process.env.BACKEND || 'http://localhost:8080',
        changeOrigin: true,
      },
    },
  },
})
