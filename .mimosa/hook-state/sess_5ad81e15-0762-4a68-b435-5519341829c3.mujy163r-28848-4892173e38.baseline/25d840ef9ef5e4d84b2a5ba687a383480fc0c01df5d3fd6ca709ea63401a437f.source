package com.example.bloghd.controller;

import com.baomidou.mybatisplus.core.conditions.query.LambdaQueryWrapper;
import com.example.bloghd.dto.ProjectView;
import com.example.bloghd.entity.Project;
import com.example.bloghd.mapper.ProjectMapper;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;

import java.util.List;

@RestController
@RequestMapping("/api/projects")
public class ProjectController {

    private final ProjectMapper projectMapper;

    public ProjectController(ProjectMapper projectMapper) {
        this.projectMapper = projectMapper;
    }

    /** 项目列表：只含已展示的，按 sort_order 升序、id 升序 */
    @GetMapping
    public List<ProjectView> list() {
        return projectMapper
                .selectList(new LambdaQueryWrapper<Project>()
                        .eq(Project::getVisible, true)
                        .orderByAsc(Project::getSortOrder, Project::getId))
                .stream()
                .map(ProjectView::from)
                .toList();
    }
}
