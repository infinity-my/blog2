package com.example.bloghd.controller;

import com.baomidou.mybatisplus.core.toolkit.Wrappers;
import com.example.bloghd.entity.ResumeContent;
import com.example.bloghd.mapper.ResumeContentMapper;
import com.fasterxml.jackson.core.JsonProcessingException;
import com.fasterxml.jackson.core.type.TypeReference;
import com.fasterxml.jackson.databind.ObjectMapper;
import org.springframework.http.HttpStatus;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PutMapping;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;
import org.springframework.web.server.ResponseStatusException;

import java.time.LocalDateTime;
import java.time.format.DateTimeFormatter;
import java.util.Map;

/**
 * 后台的简历内容接口：resume_content 单行表的整体改写。
 * 保存即整包替换，payload.updatedAt 由服务端统一盖上保存时间，不信任前端送的时间；
 * 字段结构由前台简历页的渲染约定，这里只把守「JSON 对象 + profile.name」这条底线，
 * 再往下放宽，保存一个前台渲染不了的残包出去就是白屏。
 */
@RestController
@RequestMapping("/api/admin/resume")
public class AdminResumeController {

    /** MEDIUMTEXT 本就远够用；上限挡的是把接口当网盘存超大 JSON */
    private static final int MAX_PAYLOAD_CHARS = 200_000;
    private static final DateTimeFormatter STAMP = DateTimeFormatter.ofPattern("yyyy-MM-dd HH:mm");

    /** 与 AdminPostController 同一套约定：Boot 4 容器默认 Jackson 3，直接实例化 */
    private static final ObjectMapper JSON = new ObjectMapper();

    private final ResumeContentMapper resumeContentMapper;

    public AdminResumeController(ResumeContentMapper resumeContentMapper) {
        this.resumeContentMapper = resumeContentMapper;
    }

    @GetMapping
    public ResumeDetail detail() {
        ResumeContent row = firstRow();
        if (row == null) {
            return new ResumeDetail(null, null);
        }
        try {
            return new ResumeDetail(JSON.readValue(row.getPayload(), new TypeReference<>() {}), row.getUpdatedAt());
        } catch (JsonProcessingException e) {
            throw new IllegalStateException("简历内容 JSON 解析失败 id=" + row.getId(), e);
        }
    }

    @PutMapping
    public ResumeDetail update(@RequestBody ResumeForm form) throws JsonProcessingException {
        // content 定位成 Object：MVC 侧的 Jackson 3 反序列化不了 Jackson 2 的 JsonNode，
        // JSON 对象落到手就是 LinkedHashMap，改字段、再序列化都直来直去
        Object content = form.content();
        if (content == null) {
            // 清空：前台口令门后面的正文页会显示「简历内容为空」
            resumeContentMapper.delete(null);
            return new ResumeDetail(null, null);
        }
        if (!(content instanceof Map)) {
            throw new ResponseStatusException(HttpStatus.BAD_REQUEST, "简历内容必须是 JSON 对象");
        }
        @SuppressWarnings("unchecked")
        Map<String, Object> payloadMap = (Map<String, Object>) content;
        Object name = payloadMap.get("profile") instanceof Map<?, ?> profile ? profile.get("name") : null;
        if (!(name instanceof String text) || text.isBlank()) {
            throw new ResponseStatusException(HttpStatus.BAD_REQUEST, "简历内容缺少 profile.name，前台渲染不了");
        }

        LocalDateTime now = LocalDateTime.now().withNano(0);
        payloadMap.put("updatedAt", STAMP.format(now));
        String payload = JSON.writeValueAsString(payloadMap);
        if (payload.length() > MAX_PAYLOAD_CHARS) {
            throw new ResponseStatusException(HttpStatus.BAD_REQUEST, "简历内容不能超过 " + MAX_PAYLOAD_CHARS + " 字");
        }

        ResumeContent row = firstRow();
        if (row == null) {
            row = new ResumeContent();
        }
        row.setPayload(payload);
        row.setUpdatedAt(now);
        if (row.getId() == null) {
            resumeContentMapper.insert(row);
        } else {
            resumeContentMapper.updateById(row);
        }
        return new ResumeDetail(payloadMap, now);
    }

    private ResumeContent firstRow() {
        return resumeContentMapper.selectOne(Wrappers.<ResumeContent>lambdaQuery()
                .orderByAsc(ResumeContent::getId)
                .last("LIMIT 1"));
    }

    public record ResumeDetail(Map<String, Object> content, LocalDateTime updatedAt) {
    }

    public record ResumeForm(Object content) {
    }
}
