package com.example.bloghd.controller;

import com.baomidou.mybatisplus.core.toolkit.Wrappers;
import com.example.bloghd.entity.AdminAccount;
import com.example.bloghd.entity.AppUser;
import com.example.bloghd.entity.Comment;
import com.example.bloghd.entity.LikeRecord;
import com.example.bloghd.entity.Message;
import com.example.bloghd.entity.MessageReply;
import com.example.bloghd.mapper.AdminAccountMapper;
import com.example.bloghd.mapper.AppUserMapper;
import com.example.bloghd.mapper.CommentMapper;
import com.example.bloghd.mapper.LikeRecordMapper;
import com.example.bloghd.mapper.MessageMapper;
import com.example.bloghd.mapper.MessageReplyMapper;
import com.example.bloghd.security.LoginRateLimiter;
import jakarta.servlet.Filter;
import jakarta.servlet.http.Cookie;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.boot.test.context.SpringBootTest;
import org.springframework.http.MediaType;
import org.springframework.mock.web.MockHttpSession;
import org.springframework.security.crypto.password.PasswordEncoder;
import org.springframework.test.context.ActiveProfiles;
import org.springframework.test.context.DynamicPropertyRegistry;
import org.springframework.test.context.DynamicPropertySource;
import org.springframework.test.web.servlet.MockMvc;
import org.springframework.test.web.servlet.MvcResult;
import org.springframework.test.web.servlet.request.MockHttpServletRequestBuilder;
import org.springframework.test.web.servlet.setup.MockMvcBuilders;
import org.springframework.web.context.WebApplicationContext;

import java.time.LocalDateTime;
import java.util.UUID;

import static org.assertj.core.api.Assertions.assertThat;
import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.delete;
import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get;
import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post;
import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.put;
import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath;
import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;

@SpringBootTest
// 管理员口令运行期随机生成（见下方 DynamicPropertySource），源码不出现凭据字面量
@ActiveProfiles("test")
class AdminAccountUserApiTest {

    private static final String ADMIN_USERNAME = "admin";
    private static final String ADMIN_PASSWORD = "pwd-" + UUID.randomUUID().toString().substring(0, 12);
    // 新建的编辑账号与访客口令同样运行期随机生成
    private static final String EDITOR_USERNAME = "editor";
    private static final String EDITOR_PASSWORD = "pwd-" + UUID.randomUUID().toString().substring(0, 12);
    private static final String VISITOR_EMAIL = "visitor@example.com";
    private static final String VISITOR_PASSWORD = "pwd-" + UUID.randomUUID().toString().substring(0, 12);

    @DynamicPropertySource
    static void adminProps(DynamicPropertyRegistry registry) {
        registry.add("blog.admin.username", () -> ADMIN_USERNAME);
        registry.add("blog.admin.password", () -> ADMIN_PASSWORD);
    }

    @Autowired
    private WebApplicationContext context;

    @Autowired
    private AdminAccountMapper adminAccountMapper;

    @Autowired
    private AppUserMapper appUserMapper;

    @Autowired
    private MessageMapper messageMapper;

    @Autowired
    private MessageReplyMapper messageReplyMapper;

    @Autowired
    private CommentMapper commentMapper;

    @Autowired
    private LikeRecordMapper likeRecordMapper;

    @Autowired
    private LoginRateLimiter rateLimiter;

    private MockMvc mockMvc;
    private Cookie csrfCookie;

    @BeforeEach
    void setUp() throws Exception {
        // 手工构建的 MockMvc 不会挂载安全过滤链，必须显式加上，否则鉴权被整体绕过
        mockMvc = MockMvcBuilders.webAppContextSetup(context)
                .addFilters(context.getBean("springSecurityFilterChain", Filter.class))
                .build();
        messageReplyMapper.delete(null);
        messageMapper.delete(null);
        commentMapper.delete(null);
        likeRecordMapper.delete(null);
        appUserMapper.delete(null);
        // admin 账号行整体重建为配置口令（改密码的测试可能中途失败留下脏状态），
        // 其余账号行全部清掉，保证确定性
        adminAccountMapper.delete(null);
        AdminAccount fresh = new AdminAccount();
        fresh.setUsername(ADMIN_USERNAME);
        fresh.setDisplayName("博主");
        fresh.setPasswordHash(passwordEncoder.encode(ADMIN_PASSWORD));
        fresh.setEnabled(true);
        fresh.setCreatedAt(LocalDateTime.now().withNano(0));
        adminAccountMapper.insert(fresh);
        rateLimiter.reset("admin:" + ADMIN_USERNAME, "127.0.0.1");
        rateLimiter.reset("admin:" + EDITOR_USERNAME, "127.0.0.1");
        rateLimiter.reset("admin:" + VISITOR_EMAIL, "127.0.0.1");
        csrfCookie = mockMvc.perform(get("/api/posts"))
                .andReturn().getResponse().getCookie("XSRF-TOKEN");
    }

    @Autowired
    private PasswordEncoder passwordEncoder;

    private AdminAccount requireAdmin() {
        return adminAccountMapper.selectOne(Wrappers.<AdminAccount>lambdaQuery()
                .eq(AdminAccount::getUsername, ADMIN_USERNAME));
    }

    private MockHttpServletRequestBuilder csrf(MockHttpServletRequestBuilder builder) {
        return builder.cookie(csrfCookie).header("X-XSRF-TOKEN", csrfCookie.getValue());
    }

    private MockHttpServletRequestBuilder jsonPost(String path, String body) {
        return csrf(post(path).contentType(MediaType.APPLICATION_JSON).content(body));
    }

    private MockHttpServletRequestBuilder jsonPut(String path, String body) {
        return csrf(put(path).contentType(MediaType.APPLICATION_JSON).content(body));
    }

    private MockHttpSession adminSession() throws Exception {
        MvcResult result = mockMvc.perform(jsonPost("/api/admin/login", adminLoginBody(ADMIN_PASSWORD)))
                .andExpect(status().isOk())
                .andExpect(jsonPath("$.name").value("博主"))
                .andReturn();
        return (MockHttpSession) result.getRequest().getSession(false);
    }

    private MockHttpSession visitorSession() throws Exception {
        String body = "{\"email\":\"%s\",\"name\":\"访客\",\"password\":\"%s\"}"
                .formatted(VISITOR_EMAIL, VISITOR_PASSWORD);
        MvcResult result = mockMvc.perform(jsonPost("/api/auth/register", body))
                .andExpect(status().isCreated())
                .andReturn();
        return (MockHttpSession) result.getRequest().getSession(false);
    }

    private static String adminLoginBody(String password) {
        return "{\"username\":\"%s\",\"password\":\"%s\"}".formatted(ADMIN_USERNAME, password);
    }

    /** 后台新建一个 editor 账号，返回其 id */
    private long createEditor() throws Exception {
        MvcResult created = mockMvc.perform(jsonPost("/api/admin/accounts",
                        "{\"username\":\"%s\",\"displayName\":\"编辑\",\"password\":\"%s\"}"
                                .formatted(EDITOR_USERNAME, EDITOR_PASSWORD)).session(adminSession()))
                .andExpect(status().isCreated())
                .andExpect(jsonPath("$.username").value(EDITOR_USERNAME))
                .andExpect(jsonPath("$.current").value(false))
                .andReturn();
        return Long.parseLong(created.getResponse().getContentAsString()
                .replaceAll(".*\"id\":(\\d+).*", "$1"));
    }

    @Test
    void accountEndpointsRejectAnonymousAndVisitors() throws Exception {
        mockMvc.perform(get("/api/admin/accounts"))
                .andExpect(status().isUnauthorized());
        // 注册一次，两个断言复用同一个会话；重复注册同一邮箱会被唯一索引拦成 409
        MockHttpSession visitor = visitorSession();
        mockMvc.perform(get("/api/admin/users").session(visitor))
                .andExpect(status().isForbidden());
        mockMvc.perform(jsonPut("/api/admin/accounts/password", "{}").session(visitor))
                .andExpect(status().isForbidden());
    }

    @Test
    void accountCrudLifecycleAndDisabledLogin() throws Exception {
        long editorId = createEditor();

        // 用户名重复 409，用户名/密码格式 400
        mockMvc.perform(jsonPost("/api/admin/accounts",
                        "{\"username\":\"%s\",\"displayName\":\"编辑\",\"password\":\"%s\"}"
                                .formatted(EDITOR_USERNAME, EDITOR_PASSWORD)).session(adminSession()))
                .andExpect(status().isConflict())
                .andExpect(jsonPath("$.code").value("USERNAME_TAKEN"));
        mockMvc.perform(jsonPost("/api/admin/accounts",
                        "{\"username\":\"bad name!\",\"displayName\":\"编辑\",\"password\":\"%s\"}"
                                .formatted(EDITOR_PASSWORD)).session(adminSession()))
                .andExpect(status().isBadRequest());
        mockMvc.perform(jsonPost("/api/admin/accounts",
                        "{\"username\":\"editor2\",\"displayName\":\"编辑\",\"password\":\"12345\"}").session(adminSession()))
                .andExpect(status().isBadRequest());

        // 新账号可以登录，me 返回其显示名
        mockMvc.perform(jsonPost("/api/admin/login",
                        "{\"username\":\"%s\",\"password\":\"%s\"}".formatted(EDITOR_USERNAME, EDITOR_PASSWORD)))
                .andExpect(status().isOk())
                .andExpect(jsonPath("$.name").value("编辑"));
        rateLimiter.reset("admin:" + EDITOR_USERNAME, "127.0.0.1");

        // 停用后登录被拒（与口令错误同一文案，不泄露账号状态）
        mockMvc.perform(jsonPut("/api/admin/accounts/" + editorId,
                        "{\"displayName\":\"编辑\",\"enabled\":false}").session(adminSession()))
                .andExpect(status().isOk())
                .andExpect(jsonPath("$.enabled").value(false));
        mockMvc.perform(jsonPost("/api/admin/login",
                        "{\"username\":\"%s\",\"password\":\"%s\"}".formatted(EDITOR_USERNAME, EDITOR_PASSWORD)))
                .andExpect(status().isUnauthorized())
                .andExpect(jsonPath("$.code").value("BAD_CREDENTIALS"));
        rateLimiter.reset("admin:" + EDITOR_USERNAME, "127.0.0.1");

        // 编辑账号改密码并顺带重新启用：老口令失效、新口令生效
        mockMvc.perform(jsonPut("/api/admin/accounts/" + editorId,
                        "{\"password\":\"%s\",\"enabled\":true}".formatted(EDITOR_PASSWORD + "-new"))
                        .session(adminSession()))
                .andExpect(status().isOk())
                .andExpect(jsonPath("$.enabled").value(true));
        mockMvc.perform(jsonPost("/api/admin/login",
                        "{\"username\":\"%s\",\"password\":\"%s\"}".formatted(EDITOR_USERNAME, EDITOR_PASSWORD)))
                .andExpect(status().isUnauthorized());
        mockMvc.perform(jsonPost("/api/admin/login",
                        "{\"username\":\"%s\",\"password\":\"%s\"}".formatted(EDITOR_USERNAME, EDITOR_PASSWORD + "-new")))
                .andExpect(status().isOk());
        rateLimiter.reset("admin:" + EDITOR_USERNAME, "127.0.0.1");

        // 列表按 id 正序，admin 在首位且 current=true
        mockMvc.perform(get("/api/admin/accounts").session(adminSession()))
                .andExpect(status().isOk())
                .andExpect(jsonPath("$[0].username").value(ADMIN_USERNAME))
                .andExpect(jsonPath("$[0].current").value(true))
                .andExpect(jsonPath("$[1].username").value(EDITOR_USERNAME))
                .andExpect(jsonPath("$[1].current").value(false));

        // 删除后列表里没有；再删一次 404
        mockMvc.perform(csrf(delete("/api/admin/accounts/" + editorId)).session(adminSession()))
                .andExpect(status().isNoContent());
        mockMvc.perform(csrf(delete("/api/admin/accounts/" + editorId)).session(adminSession()))
                .andExpect(status().isNotFound());
        assertThat(adminAccountMapper.selectCount(null)).isEqualTo(1);
    }

    @Test
    void selfAndLastEnabledAccountAreProtected() throws Exception {
        // 不能停用/删除当前登录的账号
        long selfId = requireAdmin().getId();
        mockMvc.perform(jsonPut("/api/admin/accounts/" + selfId,
                        "{\"enabled\":false}").session(adminSession()))
                .andExpect(status().isBadRequest())
                .andExpect(jsonPath("$.code").value("CANNOT_DISABLE_SELF"));
        mockMvc.perform(csrf(delete("/api/admin/accounts/" + selfId)).session(adminSession()))
                .andExpect(status().isBadRequest())
                .andExpect(jsonPath("$.code").value("CANNOT_DELETE_SELF"));

        // 修复后的行为：自己的行被停用后，冻结的旧会话在下一个请求就被吊销（401），
        // 拿旧会话去停掉场上最后一个启用账号这条路已经不存在 ——
        // LAST_ADMIN 守卫保留在控制器里，只给并发停用的竞态兜底
        long editorId = createEditor();
        MockHttpSession session = adminSession();
        adminAccountMapper.update(null, Wrappers.<AdminAccount>lambdaUpdate()
                .set(AdminAccount::getEnabled, false)
                .ne(AdminAccount::getUsername, EDITOR_USERNAME));
        mockMvc.perform(jsonPut("/api/admin/accounts/" + editorId,
                        "{\"enabled\":false}").session(session))
                .andExpect(status().isUnauthorized());
        assertThat(session.isInvalid()).isTrue();
    }

    @Test
    void adminCanChangeOwnPassword() throws Exception {
        // 先用配置口令登入，后续改密都复用这个会话（改密不影响已发放的会话）
        MockHttpSession session = adminSession();
        mockMvc.perform(jsonPut("/api/admin/accounts/password",
                        "{\"oldPassword\":\"wrong\",\"newPassword\":\"%s\"}".formatted(EDITOR_PASSWORD))
                        .session(session))
                .andExpect(status().isForbidden())
                .andExpect(jsonPath("$.code").value("WRONG_PASSWORD"));

        String newPassword = ADMIN_PASSWORD + "-changed";
        mockMvc.perform(jsonPut("/api/admin/accounts/password",
                        "{\"oldPassword\":\"%s\",\"newPassword\":\"%s\"}".formatted(ADMIN_PASSWORD, newPassword))
                        .session(session))
                .andExpect(status().isNoContent());

        // 新口令能登录，旧口令不能
        mockMvc.perform(jsonPost("/api/admin/login", adminLoginBody(newPassword)))
                .andExpect(status().isOk());
        rateLimiter.reset("admin:" + ADMIN_USERNAME, "127.0.0.1");
        mockMvc.perform(jsonPost("/api/admin/login", adminLoginBody(ADMIN_PASSWORD)))
                .andExpect(status().isUnauthorized());
        rateLimiter.reset("admin:" + ADMIN_USERNAME, "127.0.0.1");

        // 改回配置口令，别把脏状态留给其他测试
        mockMvc.perform(jsonPut("/api/admin/accounts/password",
                        "{\"oldPassword\":\"%s\",\"newPassword\":\"%s\"}".formatted(newPassword, ADMIN_PASSWORD))
                        .session(session))
                .andExpect(status().isNoContent());
        mockMvc.perform(jsonPost("/api/admin/login", adminLoginBody(ADMIN_PASSWORD)))
                .andExpect(status().isOk());
        rateLimiter.reset("admin:" + ADMIN_USERNAME, "127.0.0.1");
    }

    /** PUT 编辑接口改自己的密码与 /password 同规矩：必须先对上原密码（重置他人密码不要求） */
    @Test
    void selfPasswordChangeViaPutRequiresOldPassword() throws Exception {
        long selfId = requireAdmin().getId();
        MockHttpSession session = adminSession();

        mockMvc.perform(jsonPut("/api/admin/accounts/" + selfId,
                        "{\"password\":\"%s\"}".formatted(ADMIN_PASSWORD + "-x")).session(session))
                .andExpect(status().isForbidden())
                .andExpect(jsonPath("$.code").value("WRONG_PASSWORD"));
        mockMvc.perform(jsonPut("/api/admin/accounts/" + selfId,
                        "{\"password\":\"%s\",\"oldPassword\":\"nope\"}".formatted(ADMIN_PASSWORD + "-x")).session(session))
                .andExpect(status().isForbidden())
                .andExpect(jsonPath("$.code").value("WRONG_PASSWORD"));

        // 对上原密码才放行；改完新口令可登录，随后改回配置口令别留脏状态
        mockMvc.perform(jsonPut("/api/admin/accounts/" + selfId,
                        "{\"password\":\"%s\",\"oldPassword\":\"%s\"}"
                                .formatted(ADMIN_PASSWORD + "-x", ADMIN_PASSWORD)).session(session))
                .andExpect(status().isOk());
        mockMvc.perform(jsonPost("/api/admin/login", adminLoginBody(ADMIN_PASSWORD + "-x")))
                .andExpect(status().isOk());
        rateLimiter.reset("admin:" + ADMIN_USERNAME, "127.0.0.1");
        mockMvc.perform(jsonPut("/api/admin/accounts/" + selfId,
                        "{\"password\":\"%s\",\"oldPassword\":\"%s\"}"
                                .formatted(ADMIN_PASSWORD, ADMIN_PASSWORD + "-x")).session(session))
                .andExpect(status().isOk());
        mockMvc.perform(jsonPost("/api/admin/login", adminLoginBody(ADMIN_PASSWORD)))
                .andExpect(status().isOk());
        rateLimiter.reset("admin:" + ADMIN_USERNAME, "127.0.0.1");
    }

    @Test
    void userListResetPasswordAndAnonymizingDelete() throws Exception {
        visitorSession();
        AppUser user = appUserMapper.selectList(null).get(0);

        // 发言样本：1 条评论、1 条主楼、1 条回复、1 条点赞记录
        Comment comment = new Comment();
        comment.setArticleId(1L);
        comment.setUserId(user.getId());
        comment.setName(user.getName());
        comment.setContent("会被保留的评论");
        comment.setCreatedAt(LocalDateTime.now().withNano(0));
        commentMapper.insert(comment);

        Message message = new Message();
        message.setName(user.getName());
        message.setContent("会被保留的留言");
        message.setUserId(user.getId());
        message.setLikes(0);
        message.setCreatedAt(LocalDateTime.now().withNano(0));
        messageMapper.insert(message);

        MessageReply reply = new MessageReply();
        reply.setMessageId(message.getId());
        reply.setName(user.getName());
        reply.setContent("会被保留的回复");
        reply.setUserId(user.getId());
        reply.setLikes(0);
        reply.setCreatedAt(LocalDateTime.now().withNano(0));
        messageReplyMapper.insert(reply);

        LikeRecord like = new LikeRecord();
        like.setTargetType("message");
        like.setTargetId(message.getId());
        like.setVisitorKey("u:" + user.getId());
        like.setCreatedAt(LocalDateTime.now().withNano(0));
        likeRecordMapper.insert(like);

        // 列表带发言计数（留言含回复）
        mockMvc.perform(get("/api/admin/users").session(adminSession()))
                .andExpect(status().isOk())
                .andExpect(jsonPath("$[0].email").value(VISITOR_EMAIL))
                .andExpect(jsonPath("$[0].commentCount").value(1))
                .andExpect(jsonPath("$[0].messageCount").value(2));

        // 重置密码：旧口令失效，新口令能登录
        String resetPassword = "pwd-" + UUID.randomUUID().toString().substring(0, 12) + "-reset";
        mockMvc.perform(jsonPut("/api/admin/users/" + user.getId() + "/password",
                        "{\"password\":\"%s\"}".formatted(resetPassword)).session(adminSession()))
                .andExpect(status().isNoContent());
        mockMvc.perform(jsonPost("/api/auth/login",
                        "{\"email\":\"%s\",\"password\":\"%s\"}".formatted(VISITOR_EMAIL, VISITOR_PASSWORD)))
                .andExpect(status().isUnauthorized());
        mockMvc.perform(jsonPost("/api/auth/login",
                        "{\"email\":\"%s\",\"password\":\"%s\"}".formatted(VISITOR_EMAIL, resetPassword)))
                .andExpect(status().isOk());

        // 删除用户：发言保留但归属置空，点赞记录随号消失
        mockMvc.perform(csrf(delete("/api/admin/users/" + user.getId())).session(adminSession()))
                .andExpect(status().isNoContent());
        assertThat(appUserMapper.selectCount(null)).isZero();
        assertThat(commentMapper.selectList(null)).hasSize(1)
                .allSatisfy(c -> assertThat(c.getUserId()).isNull());
        assertThat(messageMapper.selectList(null)).hasSize(1)
                .allSatisfy(m -> assertThat(m.getUserId()).isNull());
        assertThat(messageReplyMapper.selectList(null)).hasSize(1)
                .allSatisfy(r -> assertThat(r.getUserId()).isNull());
        assertThat(likeRecordMapper.selectCount(null)).isZero();

        // 再删一次 404
        mockMvc.perform(csrf(delete("/api/admin/users/" + user.getId())).session(adminSession()))
                .andExpect(status().isNotFound());
    }
}
