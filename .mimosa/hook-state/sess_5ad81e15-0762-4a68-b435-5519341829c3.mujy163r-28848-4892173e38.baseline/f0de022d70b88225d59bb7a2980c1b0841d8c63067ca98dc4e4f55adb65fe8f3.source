plugins {
    id 'java'
    id 'org.springframework.boot' version '4.1.1'
    id 'io.spring.dependency-management' version '1.1.7'
}

group = 'com.example'
version = '0.0.1-SNAPSHOT'
description = 'blog-hd'

java {
    toolchain {
        languageVersion = JavaLanguageVersion.of(21)
    }
}

repositories {
    mavenCentral()
}

dependencies {
    implementation 'org.springframework.boot:spring-boot-starter-webmvc'
    implementation 'org.springframework.boot:spring-boot-starter-security'

    implementation platform('com.baomidou:mybatis-plus-bom:3.5.17')
    implementation 'com.baomidou:mybatis-plus-spring-boot4-starter'
    implementation 'com.baomidou:mybatis-plus-jsqlparser'
    // Boot 4 默认 Jackson 3，MyBatis-Plus 的 JacksonTypeHandler 仍需 Jackson 2
    implementation 'com.fasterxml.jackson.core:jackson-databind:2.20.0'

    compileOnly 'org.projectlombok:lombok'
    runtimeOnly 'com.mysql:mysql-connector-j'
    // dev profile（H2 内存库）只在开发期用：developmentOnly 会进 bootRun 的 classpath，
    // 但被 bootJar 排除，生产产物里不会带上内存库；测试由 testImplementation 提供
    developmentOnly 'com.h2database:h2'
    annotationProcessor 'org.projectlombok:lombok'
    testImplementation 'org.springframework.boot:spring-boot-starter-webmvc-test'
    testImplementation 'com.h2database:h2'
    testCompileOnly 'org.projectlombok:lombok'
    testRuntimeOnly 'org.junit.platform:junit-platform-launcher'
    testAnnotationProcessor 'org.projectlombok:lombok'
}

tasks.named('test') {
    useJUnitPlatform()
}
