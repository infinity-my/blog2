package com.example.bloghd.controller;

import com.baomidou.mybatisplus.core.conditions.query.LambdaQueryWrapper;
import com.example.bloghd.dto.EssayView;
import com.example.bloghd.entity.Essay;
import com.example.bloghd.mapper.EssayMapper;
import com.example.bloghd.support.LinkPolicy;
import com.example.bloghd.support.TagPool;
import com.fasterxml.jackson.core.JsonProcessingException;
import com.fasterxml.jackson.databind.ObjectMapper;
import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.DeleteMapping;
import org.springframework.web.bind.annotation.PathVariable;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.PutMapping;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;
import org.springframework.web.server.ResponseStatusException;

import java.time.LocalDate;
import java.util.List;

/**
 * 后台的随笔维护接口：新增、修改、删除。
 * 段落/图片/标签列表以 JSON 落库，序列化后必须装得进表列宽，超宽在入口就拦下。
 * 列表复用公开的 /api/essays（本就公开）。
 */
@RestController
@RequestMapping("/api/admin/essays")
public class AdminEssayController {

    private static final int MAX_MOOD = 20;
    private static final int MAX_LOCATION = 100;
    private static final int MAX_PARAGRAPH = 500;
    private static final int MAX_PARAGRAPHS = 10;
    private static final int MAX_IMAGES = 5;
    private static final int MAX_IMAGE_URL = 300;
    private static final int MAX_TAGS = 10;
    private static final int MAX_TAG = 30;
    /** 与表列宽对齐：paragraphs VARCHAR(2000) / images VARCHAR(500) / tags VARCHAR(300) */
    private static final int PARAGRAPHS_JSON = 2000;
    private static final int IMAGES_JSON = 500;
    private static final int TAGS_JSON = 300;

    /** Jackson 2 与实体的 JacksonTypeHandler 同源，校验序列化尺寸用它 */
    private static final ObjectMapper JSON = new ObjectMapper();

    private final EssayMapper essayMapper;
    private final TagPool tagPool;

    public AdminEssayController(EssayMapper essayMapper, TagPool tagPool) {
        this.essayMapper = essayMapper;
        this.tagPool = tagPool;
    }

    @PostMapping
    public ResponseEntity<EssayView> create(@RequestBody EssayForm form) {
        Essay essay = new Essay();
        apply(essay, form);
        essayMapper.insert(essay);
        tagPool.upsertAll(essay.getTags());
        return ResponseEntity.status(HttpStatus.CREATED).body(EssayView.from(essay));
    }

    @PutMapping("/{id}")
    public EssayView update(@PathVariable Long id, @RequestBody EssayForm form) {
        Essay essay = essayMapper.selectById(id);
        if (essay == null) {
            throw new ResponseStatusException(HttpStatus.NOT_FOUND, "随笔不存在");
        }
        apply(essay, form);
        essayMapper.updateById(essay);
        tagPool.upsertAll(essay.getTags());
        return EssayView.from(essay);
    }

    @DeleteMapping("/{id}")
    public ResponseEntity<Void> delete(@PathVariable Long id) {
        if (essayMapper.deleteById(id) == 0) {
            throw new ResponseStatusException(HttpStatus.NOT_FOUND, "随笔不存在");
        }
        return ResponseEntity.noContent().build();
    }

    private void apply(Essay essay, EssayForm form) {
        if (form.essayDate() == null) {
            throw new ResponseStatusException(HttpStatus.BAD_REQUEST, "随笔日期必填");
        }
        if (form.mood() != null && trimmed(form.mood()).length() > MAX_MOOD) {
            throw new ResponseStatusException(HttpStatus.BAD_REQUEST, "心情不能超过 " + MAX_MOOD + " 字");
        }
        if (form.location() != null && trimmed(form.location()).length() > MAX_LOCATION) {
            throw new ResponseStatusException(HttpStatus.BAD_REQUEST, "地点不能超过 " + MAX_LOCATION + " 字");
        }
        List<String> paragraphs = cleanList(form.text());
        if (paragraphs.isEmpty()) {
            throw new ResponseStatusException(HttpStatus.BAD_REQUEST, "随笔内容不能为空");
        }
        if (paragraphs.size() > MAX_PARAGRAPHS) {
            throw new ResponseStatusException(HttpStatus.BAD_REQUEST, "段落最多 " + MAX_PARAGRAPHS + " 段");
        }
        if (paragraphs.stream().anyMatch(p -> p.length() > MAX_PARAGRAPH)) {
            throw new ResponseStatusException(HttpStatus.BAD_REQUEST, "单段不能超过 " + MAX_PARAGRAPH + " 字");
        }
        List<String> images = cleanList(form.images());
        // 配图进公共页面的 <img :src>：scheme 规则与项目链接一致（LinkPolicy）
        if (images.size() > MAX_IMAGES || images.stream().anyMatch(AdminEssayController::badImage)) {
            throw new ResponseStatusException(HttpStatus.BAD_REQUEST,
                    "配图最多 " + MAX_IMAGES + " 张，地址必须是 https:// 外链或站内 "
                            + LinkPolicy.ASSET_PREFIX + " 素材，且不超过 " + MAX_IMAGE_URL + " 字");
        }
        List<String> tags = cleanList(form.tags());
        if (tags.size() > MAX_TAGS || tags.stream().anyMatch(t -> t.length() > MAX_TAG)) {
            throw new ResponseStatusException(HttpStatus.BAD_REQUEST,
                    "标签最多 " + MAX_TAGS + " 个，每个不超过 " + MAX_TAG + " 字");
        }
        checkJsonFits("段落", paragraphs, PARAGRAPHS_JSON);
        checkJsonFits("配图", images, IMAGES_JSON);
        checkJsonFits("标签", tags, TAGS_JSON);

        essay.setEssayDate(LocalDate.from(form.essayDate()));
        essay.setMood(blankToNull(form.mood()));
        essay.setLocation(blankToNull(form.location()));
        essay.setParagraphs(paragraphs);
        essay.setImages(images);
        essay.setTags(tags);
    }

    private static List<String> cleanList(List<String> raw) {
        return raw == null ? List.of() : raw.stream()
                .map(AdminEssayController::trimmed)
                .filter(s -> !s.isEmpty())
                .toList();
    }

    private static void checkJsonFits(String label, List<String> value, int max) {
        try {
            if (JSON.writeValueAsString(value).length() > max) {
                throw new ResponseStatusException(HttpStatus.BAD_REQUEST, label + "内容过多");
            }
        } catch (JsonProcessingException e) {
            throw new ResponseStatusException(HttpStatus.BAD_REQUEST, label + "无法序列化");
        }
    }

    private static String blankToNull(String value) {
        String text = trimmed(value);
        return text.isEmpty() ? null : text;
    }

    private static String trimmed(String raw) {
        return raw == null ? "" : raw.trim();
    }

    private static boolean badImage(String url) {
        return url.length() > MAX_IMAGE_URL || !LinkPolicy.allowed(url);
    }

    public record EssayForm(LocalDate essayDate,
                            String mood,
                            String location,
                            List<String> text,
                            List<String> images,
                            List<String> tags) {

        static EssayForm of(LocalDate date, List<String> text) {
            return new EssayForm(date, null, null, text, null, null);
        }
    }
}
