package com.example.bloghd.controller;

import com.baomidou.mybatisplus.core.conditions.query.LambdaQueryWrapper;
import com.example.bloghd.dto.ReplyView;
import com.example.bloghd.entity.Message;
import com.example.bloghd.entity.MessageReply;
import com.example.bloghd.mapper.MessageMapper;
import com.example.bloghd.mapper.MessageReplyMapper;
import com.example.bloghd.security.CurrentUser;
import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.DeleteMapping;
import org.springframework.web.bind.annotation.PathVariable;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;
import org.springframework.web.server.ResponseStatusException;

import java.time.LocalDateTime;

/**
 * 后台的留言治理接口：删除（清垃圾留言）与以博主身份回复。
 * 删主楼连同回复一起删；删回复只动回复自己。
 */
@RestController
@RequestMapping("/api/admin/messages")
public class AdminMessageController {

    private static final int MAX_CONTENT = 200;
    private static final int MAX_REPLY_TO = 50;

    private final MessageMapper messageMapper;
    private final MessageReplyMapper messageReplyMapper;
    private final CurrentUser currentUser;

    public AdminMessageController(MessageMapper messageMapper,
                                  MessageReplyMapper messageReplyMapper,
                                  CurrentUser currentUser) {
        this.messageMapper = messageMapper;
        this.messageReplyMapper = messageReplyMapper;
        this.currentUser = currentUser;
    }

    @DeleteMapping("/{id}")
    public ResponseEntity<Void> delete(@PathVariable Long id) {
        if (messageMapper.selectById(id) == null) {
            throw new ResponseStatusException(HttpStatus.NOT_FOUND, "留言不存在");
        }
        // 先删回复再删主楼，避免留下挂在已消失主楼下的孤儿回复
        messageReplyMapper.delete(new LambdaQueryWrapper<MessageReply>()
                .eq(MessageReply::getMessageId, id));
        messageMapper.deleteById(id);
        return ResponseEntity.noContent().build();
    }

    @DeleteMapping("/replies/{id}")
    public ResponseEntity<Void> deleteReply(@PathVariable Long id) {
        if (messageReplyMapper.deleteById(id) == 0) {
            throw new ResponseStatusException(HttpStatus.NOT_FOUND, "回复不存在");
        }
        return ResponseEntity.noContent().build();
    }

    /**
     * 以博主身份回复留言：is_author 落 true，昵称取管理员名（博主）。
     * 公开接口（MessageController）永远写不出 author=true，博主徽标只能从这里产生。
     */
    @PostMapping("/{id}/replies")
    public ReplyView reply(@PathVariable Long id, @RequestBody AdminReplyForm form) {
        if (messageMapper.selectById(id) == null) {
            throw new ResponseStatusException(HttpStatus.NOT_FOUND, "留言不存在");
        }
        String content = form.content() == null ? "" : form.content().trim();
        if (content.isEmpty()) {
            throw new ResponseStatusException(HttpStatus.BAD_REQUEST, "回复内容不能为空");
        }
        if (content.length() > MAX_CONTENT) {
            throw new ResponseStatusException(HttpStatus.BAD_REQUEST, "回复不能超过 " + MAX_CONTENT + " 字");
        }
        String replyTo = form.replyTo() == null ? "" : form.replyTo().trim();

        MessageReply reply = new MessageReply();
        reply.setMessageId(id);
        reply.setName(currentUser.require().name());
        reply.setContent(content);
        reply.setLikes(0);
        reply.setCreatedAt(LocalDateTime.now().withNano(0));
        reply.setIsAuthor(true);
        reply.setReplyTo(replyTo.isEmpty() ? null : (replyTo.length() > MAX_REPLY_TO
                ? replyTo.substring(0, MAX_REPLY_TO) : replyTo));
        reply.setUserId(null);
        messageReplyMapper.insert(reply);
        return ReplyView.from(reply, false);
    }

    public record AdminReplyForm(String content, String replyTo) {
    }
}
