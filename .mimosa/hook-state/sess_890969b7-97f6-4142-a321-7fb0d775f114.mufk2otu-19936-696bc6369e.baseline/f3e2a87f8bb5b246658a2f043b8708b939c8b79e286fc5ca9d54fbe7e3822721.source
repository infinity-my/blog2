package com.example.bloghd.controller;

import com.baomidou.mybatisplus.core.conditions.query.LambdaQueryWrapper;
import com.example.bloghd.dto.PhotoView;
import com.example.bloghd.entity.AlbumPhoto;
import com.example.bloghd.mapper.AlbumPhotoMapper;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;

import java.util.List;

@RestController
@RequestMapping("/api/album")
public class AlbumController {

    private final AlbumPhotoMapper albumPhotoMapper;

    public AlbumController(AlbumPhotoMapper albumPhotoMapper) {
        this.albumPhotoMapper = albumPhotoMapper;
    }

    /** 照片列表，拍摄时间倒序 */
    @GetMapping("/photos")
    public List<PhotoView> photos() {
        return albumPhotoMapper
                .selectList(new LambdaQueryWrapper<AlbumPhoto>()
                        .orderByDesc(AlbumPhoto::getShootDate, AlbumPhoto::getId))
                .stream()
                .map(PhotoView::from)
                .toList();
    }
}
