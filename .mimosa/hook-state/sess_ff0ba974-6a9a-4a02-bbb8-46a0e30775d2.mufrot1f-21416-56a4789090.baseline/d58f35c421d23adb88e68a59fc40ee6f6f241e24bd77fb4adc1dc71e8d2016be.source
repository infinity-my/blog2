package com.example.bloghd.controller;

import com.example.bloghd.entity.Article;
import com.example.bloghd.entity.SiteConfig;
import com.example.bloghd.entity.SiteVisit;
import com.example.bloghd.mapper.ArticleMapper;
import com.example.bloghd.mapper.SiteConfigMapper;
import com.example.bloghd.mapper.SiteVisitMapper;
import jakarta.servlet.Filter;
import jakarta.servlet.http.Cookie;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.boot.test.context.SpringBootTest;
import org.springframework.test.context.ActiveProfiles;
import org.springframework.test.web.servlet.MockMvc;
import org.springframework.test.web.servlet.setup.MockMvcBuilders;
import org.springframework.web.context.WebApplicationContext;

import java.time.LocalDate;

import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get;
import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post;
import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath;
import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;

@SpringBootTest
@ActiveProfiles("test")
class SiteControllerTest {

    @Autowired
    private WebApplicationContext context;

    @Autowired
    private ArticleMapper articleMapper;

    @Autowired
    private SiteConfigMapper siteConfigMapper;

    @Autowired
    private SiteVisitMapper siteVisitMapper;

    private MockMvc mockMvc;
    private Cookie csrfCookie;

    @BeforeEach
    void setUp() throws Exception {
        // 手工构建的 MockMvc 不会挂载安全过滤链，必须显式加上，否则鉴权被整体绕过
        mockMvc = MockMvcBuilders.webAppContextSetup(context)
                .addFilters(context.getBean("springSecurityFilterChain", Filter.class))
                .build();
        articleMapper.delete(null);
        siteConfigMapper.delete(null);
        siteVisitMapper.delete(null);
        csrfCookie = mockMvc.perform(get("/api/posts")).andReturn().getResponse().getCookie("XSRF-TOKEN");
    }

    private void article(String category, LocalDate date) {
        Article a = new Article();
        a.setTitle("t-" + category + "-" + date);
        a.setCategory(category);
        a.setPublishDate(date);
        a.setViews(0);
        articleMapper.insert(a);
    }

    private void visit(LocalDate date, int count) {
        SiteVisit v = new SiteVisit();
        v.setStatDate(date);
        v.setVisits(count);
        siteVisitMapper.insert(v);
    }

    @Test
    void statsCountsPostsCategoriesAndTotalVisits() throws Exception {
        article("前端", LocalDate.of(2026, 9, 1));
        article("前端", LocalDate.of(2026, 9, 2));
        article("随笔", LocalDate.of(2026, 8, 1));
        visit(LocalDate.now().minusDays(1), 30);
        visit(LocalDate.now(), 12);

        mockMvc.perform(get("/api/stats"))
                .andExpect(status().isOk())
                .andExpect(jsonPath("$.posts").value(3))
                .andExpect(jsonPath("$.categories").value(2))
                .andExpect(jsonPath("$.visits").value(42));
    }

    @Test
    void statsReturnsZeroVisitsWhenNoRecords() throws Exception {
        mockMvc.perform(get("/api/stats"))
                .andExpect(status().isOk())
                .andExpect(jsonPath("$.posts").value(0))
                .andExpect(jsonPath("$.visits").value(0));
    }

    @Test
    void visitUpsertsTodayAndReturnsUpdatedTotal() throws Exception {
        visit(LocalDate.now().minusDays(1), 100);

        mockMvc.perform(post("/api/stats/visit")
                        .cookie(csrfCookie)
                        .header("X-XSRF-TOKEN", csrfCookie.getValue()))
                .andExpect(status().isOk())
                .andExpect(jsonPath("$.visits").value(101));

        mockMvc.perform(post("/api/stats/visit")
                        .cookie(csrfCookie)
                        .header("X-XSRF-TOKEN", csrfCookie.getValue()))
                .andExpect(status().isOk())
                .andExpect(jsonPath("$.visits").value(102));
    }

    @Test
    void siteReturnsConfiguredAssetUrls() throws Exception {
        SiteConfig image = new SiteConfig();
        image.setConfigKey("hero_image");
        image.setConfigValue("/api/assets/hero.jpg");
        SiteConfig video = new SiteConfig();
        video.setConfigKey("hero_video");
        video.setConfigValue("/api/assets/hero.mp4");
        siteConfigMapper.insert(image);
        siteConfigMapper.insert(video);

        mockMvc.perform(get("/api/site"))
                .andExpect(status().isOk())
                .andExpect(jsonPath("$.heroImage").value("/api/assets/hero.jpg"))
                .andExpect(jsonPath("$.heroVideo").value("/api/assets/hero.mp4"));
    }
}
