package com.example.bloghd.controller;

import com.example.bloghd.dto.SiteAssets;
import com.example.bloghd.entity.SiteConfig;
import com.example.bloghd.mapper.SiteConfigMapper;
import org.springframework.http.HttpStatus;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PutMapping;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;
import org.springframework.web.server.ResponseStatusException;

/**
 * 后台的站点配置接口：首页背景图/视频的改写。
 * 值为空串表示清掉该配置（前台回落本地素材），null 表示不动。
 */
@RestController
@RequestMapping("/api/admin/site")
public class AdminSiteController {

    private static final int MAX_VALUE = 500;
    private static final String HERO_IMAGE_KEY = "hero_image";
    private static final String HERO_VIDEO_KEY = "hero_video";

    private final SiteConfigMapper siteConfigMapper;

    public AdminSiteController(SiteConfigMapper siteConfigMapper) {
        this.siteConfigMapper = siteConfigMapper;
    }

    @GetMapping
    public SiteAssets detail() {
        return site();
    }

    @PutMapping
    public SiteAssets update(@RequestBody SiteForm form) {
        // null 语义是「保持不变」，前端编辑器总提交完整表单，只会送值或空串
        if (form.heroImage() != null) {
            upsert(HERO_IMAGE_KEY, form.heroImage().trim());
        }
        if (form.heroVideo() != null) {
            upsert(HERO_VIDEO_KEY, form.heroVideo().trim());
        }
        return site();
    }

    private void upsert(String key, String value) {
        if (value.isEmpty()) {
            siteConfigMapper.deleteById(key);
            return;
        }
        if (value.length() > MAX_VALUE) {
            throw new ResponseStatusException(HttpStatus.BAD_REQUEST, "配置值不能超过 " + MAX_VALUE + " 字");
        }
        SiteConfig config = siteConfigMapper.selectById(key);
        if (config == null) {
            config = new SiteConfig();
            config.setConfigKey(key);
            config.setConfigValue(value);
            siteConfigMapper.insert(config);
        } else {
            config.setConfigValue(value);
            siteConfigMapper.updateById(config);
        }
    }

    private SiteAssets site() {
        return new SiteAssets(value(HERO_IMAGE_KEY), value(HERO_VIDEO_KEY));
    }

    private String value(String key) {
        SiteConfig config = siteConfigMapper.selectById(key);
        return config == null ? null : config.getConfigValue();
    }

    public record SiteForm(String heroImage, String heroVideo) {
    }
}
