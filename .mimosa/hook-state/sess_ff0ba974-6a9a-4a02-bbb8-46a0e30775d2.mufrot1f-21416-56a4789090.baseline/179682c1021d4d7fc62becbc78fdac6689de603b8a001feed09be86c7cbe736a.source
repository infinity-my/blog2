package com.example.bloghd.controller;

import com.baomidou.mybatisplus.core.conditions.query.LambdaQueryWrapper;
import com.example.bloghd.dto.SiteAssets;
import com.example.bloghd.dto.SiteStats;
import com.example.bloghd.entity.Article;
import com.example.bloghd.entity.SiteConfig;
import com.example.bloghd.mapper.ArticleMapper;
import com.example.bloghd.mapper.SiteConfigMapper;
import com.example.bloghd.mapper.SiteVisitMapper;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;

import java.time.LocalDate;
import java.util.Map;
import java.util.stream.Collectors;

@RestController
@RequestMapping("/api")
public class SiteController {

    private final ArticleMapper articleMapper;
    private final SiteConfigMapper siteConfigMapper;
    private final SiteVisitMapper siteVisitMapper;

    public SiteController(ArticleMapper articleMapper, SiteConfigMapper siteConfigMapper,
                          SiteVisitMapper siteVisitMapper) {
        this.articleMapper = articleMapper;
        this.siteConfigMapper = siteConfigMapper;
        this.siteVisitMapper = siteVisitMapper;
    }

    @GetMapping("/site")
    public SiteAssets site() {
        Map<String, String> kv = siteConfigMapper.selectList(null).stream()
                .collect(Collectors.toMap(SiteConfig::getConfigKey, SiteConfig::getConfigValue));
        return new SiteAssets(kv.get("hero_image"), kv.get("hero_video"));
    }

    @GetMapping("/stats")
    public SiteStats stats() {
        long posts = articleMapper.selectCount(null);
        long categories = articleMapper.selectList(new LambdaQueryWrapper<Article>()
                        .select(Article::getCategory))
                .stream().map(Article::getCategory).distinct().count();
        return new SiteStats(posts, categories, siteVisitMapper.sumVisits());
    }

    /** 进站上报：当日访问 +1，返回最新累计统计 */
    @PostMapping("/stats/visit")
    public SiteStats visit() {
        siteVisitMapper.upsertToday(LocalDate.now());
        return stats();
    }
}
